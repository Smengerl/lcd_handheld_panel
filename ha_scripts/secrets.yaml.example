# Add these keys to your ESPHome secrets.yaml ([homeassistant]/config/esphome/
# secrets.yaml, next to handheld-panel.yaml). If you already have a secrets.yaml,
# append the keys instead of replacing the file.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Home Assistant API encryption key - generate one with:
#   openssl rand -base64 32
handheld_panel_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# OTA update password - any strong string
handheld_panel_ota_pw: "REPLACE_WITH_A_STRONG_PASSWORD"

# Fallback hotspot password (min. 8 chars) for the access point shown when WiFi fails
handheld_panel_fallback_pw: "REPLACE_WITH_A_STRONG_PASSWORD"
